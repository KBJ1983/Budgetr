{
  "name": "budgetr",
  "private": true,
  "version": "0.1.0",
  "description": "budgetr – gratis budget for dig, par og familier. Landing page + budget app (no login yet, data in the browser).",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
